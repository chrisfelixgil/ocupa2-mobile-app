# Ocupa2 - Gitignore
# Basado en Flutter y las reglas de seguridad del proyecto (.cursorrules).

# --- Configuracion local y secretos ---
.env
.env.*
!.env.example
*.pem
*.p12
*.key
secrets/
credentials/

# --- Firmas Android ---
key.properties
**/*.keystore
**/*.jks

# --- Flutter / Dart / Pub ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/doc/api/

# --- Symbolication y ofuscacion ---
app.*.symbols
app.*.map.json

# --- Cobertura de pruebas ---
coverage/
lcov.info

# --- IDEs ---
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# --- Sistema operativo ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.stackdump

# --- Logs y temporales ---
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# --- Android (artefactos de build en app/) ---
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/.gradle/
/android/local.properties
/android/captures/
/android/.cxx/

# --- iOS ---
/ios/Flutter/.last_build_id
/ios/Flutter/ephemeral/
/ios/Pods/
/ios/.symlinks/
/ios/**/xcuserdata/
/ios/**/DerivedData/

# --- macOS ---
/macos/Flutter/ephemeral/
/macos/Pods/

# --- Windows / Linux ---
/windows/flutter/ephemeral/
/linux/flutter/ephemeral/

# --- Cursor (cache local; .cursorrules si se versiona) ---
.cursor/

# --- Bundles temporales usados para compartir cambios de Claude ---
*.bundle
